{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-conformance.example/schemas/experiment-plan.schema.json",
  "title": "Agentic Engineering Conformance neutral experiment plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "label",
    "benchmark_revision",
    "source_root",
    "output_root",
    "scenario",
    "fixture",
    "observation_mode",
    "network_policy",
    "retry_limit",
    "randomization",
    "created_at",
    "hosts",
    "trials",
    "plan_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "batch_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,95}$"
    },
    "label": {
      "const": "NEUTRAL_AUTONOMOUS_BASELINE"
    },
    "benchmark_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_root": {
      "type": "string",
      "minLength": 1
    },
    "output_root": {
      "type": "string",
      "minLength": 1
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "const": "AUTH-001"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "digest"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "observation_mode": {
      "const": "BLACK_BOX"
    },
    "network_policy": {
      "const": "RESTRICTED"
    },
    "retry_limit": {
      "const": 0
    },
    "randomization": {
      "const": "alternating-codex-first-v1"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "hosts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/host"
      }
    },
    "trials": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/trial"
      }
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "adapter_version",
        "cli_version",
        "executable",
        "requested_model",
        "config_digest",
        "sandbox_policy",
        "auth_mode",
        "auth_provider",
        "subscription_type"
      ],
      "properties": {
        "name": {
          "enum": [
            "codex",
            "claude"
          ]
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        },
        "cli_version": {
          "type": "string",
          "minLength": 1
        },
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "requested_model": {
          "type": "string",
          "minLength": 1
        },
        "config_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "sandbox_policy": {
          "type": "string",
          "minLength": 1
        },
        "auth_mode": {
          "type": "string",
          "minLength": 1
        },
        "auth_provider": {
          "type": "string",
          "minLength": 1
        },
        "subscription_type": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "run_id",
        "host",
        "ordinal"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "run_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,95}$"
        },
        "host": {
          "enum": [
            "codex",
            "claude"
          ]
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      }
    }
  }
}
