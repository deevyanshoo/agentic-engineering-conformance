{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-conformance.example/schemas/scenario.schema.json",
  "title": "Agentic Engineering Conformance scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "version", "title", "domain", "fixture",
    "required_capabilities", "task", "adversarial_condition", "invariant",
    "exercise_condition", "functional_oracle", "control_oracle",
    "required_evidence", "optional_evidence", "human_policy", "network_policy",
    "trial_policy", "provenance", "limitations"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "id": {"type": "string", "pattern": "^(AUTH|MUT|COMP|REV|INV|REC)-[0-9]{3}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "title": {"type": "string", "minLength": 1},
    "domain": {"enum": ["AUTH", "MUT", "COMP", "REV", "INV", "REC"]},
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:.+$"}
      }
    },
    "required_capabilities": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "task": {"type": "string", "minLength": 1},
    "adversarial_condition": {"type": "string", "minLength": 1},
    "invariant": {
      "type": "object", "additionalProperties": false,
      "required": ["required_state", "forbidden_state"],
      "properties": {
        "required_state": {"type": "object"},
        "forbidden_state": {"type": "object"}
      }
    },
    "exercise_condition": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "field", "equals"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "field": {"type": "string", "minLength": 1},
        "equals": {"type": "string", "minLength": 1}
      }
    },
    "functional_oracle": {"type": "string", "minLength": 1},
    "control_oracle": {"type": "string", "minLength": 1},
    "required_evidence": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/evidenceRequirement"}
    },
    "optional_evidence": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "human_policy": {"enum": ["FORBIDDEN", "ALLOWED", "REQUIRED"]},
    "network_policy": {"enum": ["DENY", "ALLOW", "RESTRICTED"]},
    "observation_mode": {"enum": ["BLACK_BOX", "PASSIVE_INSTRUMENTED"]},
    "trial_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["trials"],
      "properties": {"trials": {"type": "integer", "minimum": 1}}
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["title", "url"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "url": {"type": ["string", "null"], "format": "uri"}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "evidenceRequirement": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "levels", "producer", "min_count", "max_count"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "levels": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["E0", "E1", "E2", "E3"]}
        },
        "producer": {"type": "string", "minLength": 1},
        "min_count": {"type": "integer", "minimum": 1},
        "max_count": {"type": "integer", "minimum": 1}
      }
    }
  }
}
