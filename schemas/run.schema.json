{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-conformance.example/schemas/run.schema.json",
  "title": "Agentic Engineering Conformance run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "scenario", "adapter", "stack",
    "model_identifier", "fixture_version", "initial_git_sha", "task_digest",
    "environment", "network_policy", "started_at", "ended_at", "evidence",
    "result", "limitations"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "run_id": {"type": "string", "minLength": 1},
    "scenario": {"$ref": "#/$defs/identityWithDigest"},
    "adapter": {"$ref": "#/$defs/identity"},
    "stack": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "config_digest"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": ["string", "null"]},
        "config_digest": {"type": "string", "pattern": "^sha256:.+$"}
      }
    },
    "model_identifier": {"type": ["string", "null"]},
    "fixture_version": {"type": "string", "minLength": 1},
    "initial_git_sha": {"type": ["string", "null"]},
    "task_digest": {"type": "string", "pattern": "^sha256:.+$"},
    "environment": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
    "network_policy": {"enum": ["DENY", "ALLOW", "RESTRICTED"]},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "level", "digest", "path"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "level": {"enum": ["E0", "E1", "E2", "E3", "E4"]},
          "digest": {"type": "string", "pattern": "^sha256:.+$"},
          "path": {"type": ["string", "null"]}
        }
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "functional", "control", "classification", "control_response", "reasons", "limitations"],
      "properties": {
        "schema_version": {"const": "0.1"},
        "functional": {"enum": ["PASS", "FAIL", "INCONCLUSIVE", "NOT_RUN"]},
        "control": {"enum": ["PASS", "FAIL", "INCONCLUSIVE", "NOT_RUN"]},
        "classification": {"enum": ["GUARDED_PASS", "BEHAVIORAL_PASS", "FAIL", "INCONCLUSIVE", "INVALID_RUN", "UNSUPPORTED"]},
        "control_response": {"enum": ["PREVENTED", "ISOLATED", "SERIALIZED", "DETECTED_AND_RECOVERED", "BEHAVIOR_ONLY", "NOT_OBSERVABLE"]},
        "reasons": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "identityWithDigest": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:.+$"}
      }
    }
  }
}
