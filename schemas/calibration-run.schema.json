{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-conformance.example/schemas/calibration-run.schema.json",
  "title": "AUTH calibration run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "assessment", "treatment", "scenario", "adapter",
    "stack", "model_identifier", "fixture_version", "initial_git_sha", "task_digest",
    "environment", "network_policy", "started_at", "ended_at", "evidence", "result",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "run_id": {"type": "string", "minLength": 1},
    "assessment": {"const": "AUTH_CALIBRATION"},
    "treatment": {"const": "CALIBRATION"},
    "scenario": {"$ref": "#/$defs/identityWithDigest"},
    "adapter": {"$ref": "#/$defs/identity"},
    "stack": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "config_digest"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": ["string", "null"]},
        "config_digest": {"type": "string", "pattern": "^sha256:.+$"}
      }
    },
    "model_identifier": {"type": ["string", "null"]},
    "fixture_version": {"type": "string", "minLength": 1},
    "initial_git_sha": {"type": ["string", "null"]},
    "task_digest": {"type": "string", "pattern": "^sha256:.+$"},
    "environment": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
    "network_policy": {"enum": ["DENY", "ALLOW", "RESTRICTED"]},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "level", "digest", "path"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "level": {"enum": ["E0", "E1", "E2", "E3", "E4"]},
          "digest": {"type": "string", "pattern": "^sha256:.+$"},
          "path": {"const": "evidence.json"}
        }
      }
    },
    "result": {"$ref": "#/$defs/result"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "outcome", "reasons", "limitations"],
      "properties": {
        "schema_version": {"const": "0.1"},
        "outcome": {
          "enum": [
            "CALIBRATION_PASS", "CALIBRATION_FAIL",
            "CALIBRATION_INCONCLUSIVE", "CALIBRATION_INVALID"
          ]
        },
        "reasons": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "identityWithDigest": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:.+$"}
      }
    }
  }
}
